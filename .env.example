# Copy to .env (never commit .env). Used by the web app and documented for the IoT stack.

# --- Web (CakePHP, GENTA/) ---
DEBUG=true
SECURITY_SALT=change-me-to-a-long-random-string
DATABASE_URL=mysql://genta:password@localhost:3306/genta?encoding=utf8mb4&timezone=UTC
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@example.com
CALLBACK_SECRET=change-me
NGROK_BASE_URL=http://localhost:5000
NGROK_API_KEY=

# --- IoT (GENTA_MAIN_SYSTEM_IoT/) ---
# Prefer setting these in that folder's own .env or the process environment.
GENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=GENTA_MAIN_SYSTEM_IoT/GoogleCloud/key.json
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=genta
MYSQL_USER=genta
MYSQL_PASS=
GENTA_REPORT_UPLOAD_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
FLASK_SECRET_KEY=
GENTA_FLASK_URL=http://localhost:5000
