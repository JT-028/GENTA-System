# =============================================================================
# GENTA System — GitHub-safe ignore list
# Keeps the published repo to source code, docs, and small assets only.
# Local venvs, vendor trees, speech models, ffmpeg, and runtime data stay on disk.
# =============================================================================

# Nested git metadata (local clones of the older split repos)
**/.git.bak/
**/.git.bak
GENTA_MAIN_SYSTEM_IoT-mirror.git/

# Secrets and local config
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
credentials.json
client_secret*.json
token.json
secrets.json
GENTA/config/app_local.php
GENTA/config/app_local.production.php
GENTA/cloudways_app_local.php
GENTA_MAIN_SYSTEM_IoT/GoogleCloud/key.json
GENTA_MAIN_SYSTEM_IoT/GoogleCloud/*.json
!GENTA_MAIN_SYSTEM_IoT/GoogleCloud/key.json.example

# Python
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
newenv/
newenv.bak/
GENTA_MAIN_SYSTEM_IoT/.venv/
GENTA_MAIN_SYSTEM_IoT/newenv/

# PHP / Composer / Node
**/vendor/
**/node_modules/
GENTA/myapp/
GENTA/shepherd-main/
composer.phar

# CakePHP runtime
GENTA/logs/*
!GENTA/logs/.gitkeep
GENTA/tmp/*
!GENTA/tmp/.gitkeep
GENTA/webroot/uploads/profile_images/*
!GENTA/webroot/uploads/profile_images/.gitkeep

