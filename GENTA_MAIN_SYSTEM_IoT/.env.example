# IoT / Flask / GENTA7 environment
# Copy to .env in this folder or export in your shell. Never commit real values.

GENAI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./GoogleCloud/key.json

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=genta
MYSQL_USER=genta
MYSQL_PASS=
GENTA_MYSQL_SSL=false

GENTA_REPORT_UPLOAD_API_KEY=
FLASK_SECRET_KEY=
ADMIN_USERNAME=admin
# SHA-256 hex digest of the admin password (not the password itself)
ADMIN_PASSWORD_HASH=

ESP_BASE=http://192.168.0.10
ESP_SPEAKER=http://192.168.0.11
GENTA_FLASK_URL=http://localhost:5000
FFMPEG_PATH=

GENTA_TTS_VOICE=en-US-Neural2-C
GENTA_TTS_LANGUAGE=en-US
GENTA_TTS_PITCH=0.0
GENTA_LOG_LEVEL=INFO
